# Database Configuration for Cooperative Bank Screening Prototype
# If DB_TYPE is mysql, the system connects to your MySQL server.
# If DB_TYPE is sqlite or MySQL is unavailable, it automatically uses the local SQLite database.
DB_TYPE=sqlite
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=coop_bank_screening

# Thresholds and Screening Defaults
DEFAULT_AMOUNT_THRESHOLD=50000.0
DEFAULT_Z_SCORE_THRESHOLD=3.0
DEFAULT_LARGE_WITHDRAWAL_THRESHOLD=50000.0
DEFAULT_GRAPH_RISK_THRESHOLD=0.5

# Risk Score Weights (Sum to 1.0)
WEIGHT_RULE_RISK=0.30
WEIGHT_STATISTICAL_RISK=0.30
WEIGHT_GRAPH_RISK=0.20
WEIGHT_PATTERN_RISK=0.20

# Decision Bands
BAND_NORMAL_MAX=39
BAND_REVIEW_MAX=69
